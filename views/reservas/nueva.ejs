<section>
  <h2>Nueva reserva</h2>

  <p>Completá los datos para registrar una nueva reserva.</p>

  <% if (errores && errores.length > 0) { %>
    <div role="alert">
      <h3>Hay errores en el formulario:</h3>

      <ul>
        <% errores.forEach(error => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/reservas" method="POST">

    <div>
      <label for="estudiante">Estudiante</label>
      <input
        type="text"
        id="estudiante"
        name="estudiante"
        value="<%= datos?.estudiante || '' %>"
      >
    </div>

    <div>
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= datos?.email || '' %>"
      >
    </div>

    <div>
      <label for="sala">Sala</label>
      <select id="sala" name="sala">
        <option value="">Seleccioná una sala</option>

        <option value="Sala Norte" <%= datos?.sala === "Sala Norte" ? "selected" : "" %>>
          Sala Norte
        </option>

        <option value="Sala Sur" <%= datos?.sala === "Sala Sur" ? "selected" : "" %>>
          Sala Sur
        </option>

        <option value="Sala Multimedia" <%= datos?.sala === "Sala Multimedia" ? "selected" : "" %>>
          Sala Multimedia
        </option>
      </select>
    </div>

    <div>
      <label for="fecha">Fecha</label>
      <input
        type="date"
        id="fecha"
        name="fecha"
        value="<%= datos?.fecha || '' %>"
      >
    </div>

    <div>
      <label for="turno">Turno</label>
      <select id="turno" name="turno">
        <option value="">Seleccioná un turno</option>

        <option value="Mañana" <%= datos?.turno === "Mañana" ? "selected" : "" %>>
          Mañana
        </option>

        <option value="Tarde" <%= datos?.turno === "Tarde" ? "selected" : "" %>>
          Tarde
        </option>

        <option value="Noche" <%= datos?.turno === "Noche" ? "selected" : "" %>>
          Noche
        </option>
      </select>
    </div>

    <div>
      <label for="personas">Cantidad de personas</label>
      <input
        type="number"
        id="personas"
        name="personas"
        min="1"
        max="6"
        value="<%= datos?.personas || '' %>"
      >
    </div>

    <button type="submit">Crear reserva</button>

  </form>

  <nav aria-label="Navegación de la reserva">
    <a href="/reservas">Volver a reservas</a>
  </nav>
</section>